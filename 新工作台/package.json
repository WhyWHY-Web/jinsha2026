{
  "name": "jinsha-watershed-workbench",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node tools/check_first_screen.mjs",
    "start": "node --experimental-strip-types server/index.ts",
    "test:workflow": "node tools/verify_workflow.mjs",
    "test:live": "node tools/verify_live.mjs",
    "test:research": "node tools/verify_research.mjs",
    "test": "node tools/verify_live.mjs && node tools/verify_research.mjs && node tools/verify_view_query.mjs && node tools/verify_warning.mjs && node tools/verify_workflow.mjs",
    "export:web": "tsc --noEmit && node scripts/export_web.mjs"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.81.0",
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
}
