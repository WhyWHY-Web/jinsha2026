#!/bin/sh
# pre-push: 拦截"误删大量文件"的推送
#
# 背景：2026-11-27 的 c283fa4 在不完整的工作区执行 git add -A，
# 一次性删掉了 208 个文件（19MB），仓库只剩 2 个文件。
# 本钩子在推送前统计本次将删除的文件数，超过阈值即阻断。
#
# 安装：sh 系统/tools/hooks/install.sh
# 临时放行：ALLOW_MASS_DELETE=1 git push

LIMIT=${MASS_DELETE_LIMIT:-20}
ALLOW=${ALLOW_MASS_DELETE:-0}
ZERO=0000000000000000000000000000000000000000
blocked=0

while read local_ref local_sha remote_ref remote_sha; do
    # 删除远程分支的操作，跳过
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" = "$ZERO" ]; then
        # 新分支：以与现有远程分支的公共祖先为基线
        base=$(git merge-base "$local_sha" \
            $(git for-each-ref --format='%(refname)' refs/remotes/ 2>/dev/null) \
            2>/dev/null | head -1)
        # 找不到基线（首次推送空仓库）就跳过，全量内容不算删除
        [ -z "$base" ] && continue
    else
        base=$remote_sha
    fi

    # 本次推送将删除的文件
    deleted=$(git -c core.quotepath=false diff --diff-filter=D --name-only "$base" "$local_sha" 2>/dev/null)
    count=$(printf '%s\n' "$deleted" | grep -c . )

    if [ "$count" -gt "$LIMIT" ]; then
        blocked=1
        echo ""
        echo "================================================================"
        echo "  推送已阻断：本次将删除 $count 个文件（阈值 $LIMIT）"
        echo "  目标分支：${remote_ref#refs/heads/}"
        echo "================================================================"
        printf '%s\n' "$deleted" | head -30 | sed 's/^/    D  /'
        [ "$count" -gt 30 ] && echo "    ...（其余 $((count - 30)) 个省略）"
        echo ""
        echo "  如果这是误操作：先 git reset 或 git checkout -- <路径> 恢复文件。"
        echo "  如果确实要删：ALLOW_MASS_DELETE=1 git push"
        echo ""
    fi
done

if [ "$blocked" = "1" ] && [ "$ALLOW" != "1" ]; then
    exit 1
fi
exit 0
